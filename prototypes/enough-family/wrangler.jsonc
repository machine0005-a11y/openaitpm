{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "enough-family-prototype",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
